# Public Cloudinary delivery setting. This is not an API secret.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=mk5klko9
NEXT_PUBLIC_WANDRA_WHATSAPP_URL=https://wa.me/573214320429
NEXT_PUBLIC_WANDRA_FACEBOOK_URL=https://www.facebook.com/WandraHerenciaSaludable

# Private server-side credential. Add its real value only in Vercel or .env.local.
# Never use the NEXT_PUBLIC_ prefix and never commit the real token.
MERCADOPAGO_ACCESS_TOKEN=

# Vercel: keep the live token scoped to Production and the test token to Preview.
# Enable "Automatically expose System Environment Variables" in Vercel.
# VERCEL_ENV=preview selects sandbox_init_point and returns to the Preview host.
# NEXT_PUBLIC_VERCEL_ENV=preview displays the checkout's test notice.
# Never copy the live token into Preview or expose tokens with NEXT_PUBLIC_.

# Public production origin used for Mercado Pago return URLs.
NEXT_PUBLIC_SITE_URL=https://wandra.com.co
